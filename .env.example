APP_ENV=local
DATABASE_URL=postgresql+psycopg://policy:policy@postgres:5432/policy
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=replace-with-at-least-32-random-characters
MASTER_KEY=

OBJECT_STORE_BACKEND=s3
OBJECT_STORE_ROOT=/data/objects
S3_ENDPOINT_URL=http://object-store:8333
S3_BUCKET=policy-raw
S3_ACCESS_KEY=policyaccess
S3_SECRET_KEY=change-this-object-store-secret
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=900
LLM_MAX_RETRIES=2
# Stream completions (gateways such as the PwC one drop requests idle for ~12 minutes)
LLM_STREAM=true
# Output cap for extraction; long multi-track notices need more than the ~64k provider defaults
LLM_MAX_OUTPUT_TOKENS=131072

# Structured extraction model; unset values fall back to LLM_* (image transcription always uses LLM_*)
EXTRACTION_LLM_PROVIDER=openai_compatible
EXTRACTION_LLM_MODEL=meta/muse-spark-1.3-contributor
EXTRACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_LLM_API_KEY=
EXTRACTION_REASONING_EFFORT=high
# Second model on the LLM_* endpoint for empty, multi-track or long (>=20k chars) notices
EXTRACTION_CROSSCHECK_MODEL=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

CRAWL_USER_AGENT="PolicyHarvester/0.1 (+https://example.invalid/contact)"
CRAWL_TIMEOUT_SECONDS=45
CRAWL_MAX_CONCURRENCY=4
# Optional HTTP(S) or SOCKS5 proxy. Percent-encode special characters in credentials.
CRAWL_PROXY_URL=
CRAWL_TLS_VERIFY=true
SOURCE_MISSING_THRESHOLD=3
SOURCE_TIMEZONE=Asia/Seoul
AUTO_PUBLISH=false

# Worker processes per stage (compose.yaml). Sized for 16 cores / 64 GB: 3 / 6 / 1.
WORKER_PARSE_REPLICAS=3
WORKER_LLM_REPLICAS=6
WORKER_EMBED_REPLICAS=1
# Embedding threads per worker-embed process when the internal ONNX model is used
ONNX_THREADS=4
